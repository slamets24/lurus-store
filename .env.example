APP_NAME="Lurus Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://lurus-store.test

# Vercel: set these in Project Settings → Environment Variables (not in vercel.json):
# APP_KEY, APP_URL, DB_*, MIDTRANS_*, BITESHIP_*, MAIL_*, SESSION_SECURE_COOKIE=true
# On Vercel serverless, prefer QUEUE_CONNECTION=sync and an external DB (Neon/Supabase).
# Local disk uploads do not persist — use S3-compatible storage (FILESYSTEM_DISK=s3) for media.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lurus_store
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
DB_SEARCH_PATH=public

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

SEED_ADMIN_PASSWORD=
DEMO_ADMIN_PASSWORD=

HUGGINGFACE_API_KEY=
HUGGINGFACE_EMBEDDING_ENDPOINT=https://api-inference.huggingface.co/pipeline/feature-extraction/sentence-transformers/all-MiniLM-L6-v2

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_ORIGIN_POSTAL_CODE=
BITESHIP_ORIGIN_CONTACT_NAME="Lurus Store"
BITESHIP_ORIGIN_CONTACT_PHONE=
BITESHIP_ORIGIN_ADDRESS=
BITESHIP_FALLBACK_SHIPPING_COST=25000
BITESHIP_FREE_SHIPPING_THRESHOLD=500000
BITESHIP_ITEM_WEIGHT_GRAMS=1000
BITESHIP_ITEM_LENGTH_CM=25
BITESHIP_ITEM_WIDTH_CM=20
BITESHIP_ITEM_HEIGHT_CM=3
BITESHIP_WEBHOOK_HEADER=X-Biteship-Secret
BITESHIP_WEBHOOK_SECRET=
BITESHIP_FAKE_RATES=false

BANK_TRANSFER_BANK=BCA
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_NAME="Lurus Store"

CONTACT_TO_EMAIL=

GOOGLE_TAG_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_PURCHASE_LABEL=
GOOGLE_SITE_VERIFICATION=
